# -------------------------------------------------------------------------
# COPY THIS FILE, RENAME THE COPY TO  .env  , THEN FILL IN THE REAL VALUES.
#
# The .env file holds passwords. It is never committed and never shared.
# This example file has fake values so you can see what is needed.
# -------------------------------------------------------------------------

# The inbox the agent watches, and replies from.
GMAIL_ADDRESS=joesplumbingtest2026@gmail.com

# NOT the account password. This is the 16-character App Password from
# Google (Security -> App passwords). Spaces are fine, they get ignored.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Which client's settings to use.
CLIENT_CONFIG=clients/joes_plumbing.ini

# SAFETY SWITCH.
#   no   = practice mode. Reads the inbox, works out the reply, prints it,
#          sends NOTHING. Start here. Always.
#   yes  = actually sends emails to real customers.
SEND_FOR_REAL=no

# How often to check the inbox, in seconds. 60 matches the sales pitch.
CHECK_EVERY_SECONDS=60

# Stop after this many checks, so a test run doesn't go on forever.
# Leave blank to run until you press Ctrl+C.
STOP_AFTER_CHECKS=3


# -------------------------------------------------------------------------
# THE PLUMBER'S CALENDAR
#
# Without these the agent knows his working hours but not what he has already
# booked, so every time it offers is a guess.
# -------------------------------------------------------------------------

# The robot account that reads and writes his diary. You download this file
# once from Google Cloud (Service account -> Keys -> Add key -> JSON), put it
# in this folder, and rename it to service-account.json.
#
# THIS FILE IS A PASSWORD IN FILE FORM. Never email it, never commit it.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Which calendar to read. Normally the client's own email address.
# He must share that calendar with the robot account's email address and
# give it "Make changes to events" - otherwise the agent is locked out.
CALENDAR_ID=joesplumbingtest2026@gmail.com
